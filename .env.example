# Variables de entorno — Clinic Connect Pro
# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está en .gitignore: NO lo subas al repositorio.
#
# Las claves VITE_* se embeben en el bundle del cliente (son públicas por diseño).
# La seguridad de los datos depende de las políticas RLS de Supabase, no de ocultar la anon key.

# Supabase (panel del proyecto → Settings → API)
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_PUBLISHABLE_KEY="tu-publishable-o-anon-key"
SUPABASE_URL="https://tu-project-id.supabase.co"

# Espejo para el cliente (Vite sólo expone las que empiezan con VITE_)
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-publishable-o-anon-key"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"
